# Copy this template into local environment settings or configure the same
# variables in Render. Every placeholder below is intentionally synthetic.
# Values marked MUST DIFFER must be unique for local, staging, and production.

# Core app
# MUST DIFFER: shared token-signing secret; use a long random value.
VIDZFLOW_SECRET_KEY=example-only-replace-with-random-secret
# Seconds before an anonymous job token expires.
VIDZFLOW_JOB_TOKEN_MAX_AGE=1800
# Maximum incoming request body size in bytes.
VIDZFLOW_MAX_REQUEST_BYTES=65536

# Database
# MUST DIFFER: use each environment's own PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vidzflow
# Connection pool size per web or worker process.
DB_POOL_SIZE=5
# Extra database connections allowed above DB_POOL_SIZE.
DB_MAX_OVERFLOW=5
# Seconds to wait for a database connection from the pool.
DB_POOL_TIMEOUT=30
# Seconds before an idle pooled connection is recycled.
DB_POOL_RECYCLE=1800

# S3 storage
# MUST DIFFER: endpoint for the environment's private S3-compatible storage.
S3_ENDPOINT_URL=https://storage.example.invalid
# S3 region name; use auto only when the provider supports it.
S3_REGION=us-east-1
# MUST DIFFER: private bucket name for this environment.
S3_BUCKET=example-private-bucket
# MUST DIFFER: synthetic placeholder; replace with the real access key privately.
S3_ACCESS_KEY_ID=example-access-key-id
# MUST DIFFER: synthetic placeholder; replace with the real secret privately.
S3_SECRET_ACCESS_KEY=example-storage-secret
# Seconds that a completed-file download URL remains valid.
S3_PRESIGNED_URL_SECONDS=1800

# Worker and concurrency
# Seconds between worker queue polls.
WORKER_POLL_SECONDS=2
# Number of jobs this worker process downloads simultaneously.
WORKER_CONCURRENCY=1
# Global maximum simultaneous download reservations across workers.
MAX_CONCURRENT_DOWNLOADS=2
# Seconds before an unchanged active job is treated as stale.
WORKER_JOB_TIMEOUT_SECONDS=900
# Maximum attempts for classified temporary failures.
WORKER_MAX_ATTEMPTS=3
# Initial retry delay in seconds; later retries use capped backoff.
WORKER_RETRY_BACKOFF_SECONDS=5
# Seconds between worker heartbeat updates.
WORKER_HEARTBEAT_SECONDS=10
# Optional stable worker identifier; otherwise one is generated automatically.
# WORKER_INSTANCE_ID=example-worker-id

# Resource limits
# Seconds to retain job records and completed files; must be >= S3_PRESIGNED_URL_SECONDS.
JOB_RETENTION_SECONDS=1800
# Seconds between cleanup passes.
CLEANUP_INTERVAL_SECONDS=300
# Maximum queued or active jobs before new submissions receive HTTP 429.
MAX_ACTIVE_JOBS=20
# Maximum accepted URL length in characters.
MAX_URL_LENGTH=2048
# Maximum estimated/final download size; accepts bytes or values such as 500M.
MAX_DOWNLOAD_BYTES=500M
# Maximum total temporary disk reservation in bytes; accepts values such as 1G.
MAX_TEMP_DISK_BYTES=1G
# Required free temporary disk space in bytes; accepts values such as 256M.
MIN_FREE_DISK_BYTES=256M
# Optional local FFmpeg bin directory or executable; leave empty when the image supplies it.
FFMPEG_PATH=

# Security and tokens
# MUST DIFFER: operator bearer token for /metrics; empty means the endpoint rejects all requests.
METRICS_AUTH_TOKEN=example-only-metrics-token

# Observability and request protection
# Maximum token-bucket requests per client IP in the refill window.
RATE_LIMIT_CAPACITY=20
# Seconds for the rate-limit token bucket to refill.
RATE_LIMIT_REFILL_SECONDS=60

# Scaling plan example for a dozens-of-users target; measure before enabling.
# WORKER_CONCURRENCY=2
# MAX_CONCURRENT_DOWNLOADS=2
# MAX_ACTIVE_JOBS=50

# Legacy compatibility
# MAX_DOWNLOAD_SIZE is a legacy alias read only when MAX_DOWNLOAD_BYTES is unset.
# AWS_REGION is a legacy fallback read only when S3_REGION is unset.
