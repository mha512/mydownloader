# Copy these values into your hosting provider's environment settings.
# Do not commit a real .env file or put real secrets in this example.

# Use a long random value. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
VIDZFLOW_SECRET_KEY=replace-with-a-long-random-secret

# Anonymous job tokens expire after this many seconds.
VIDZFLOW_JOB_TOKEN_MAX_AGE=1800

# Maximum incoming request body size in bytes.
VIDZFLOW_MAX_REQUEST_BYTES=65536

# Shared database. Use the PostgreSQL connection string supplied by Render.
# SQLite is for local development only and is not production-safe on Render.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# S3-compatible private storage used by the worker.
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=your-private-bucket
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
S3_PRESIGNED_URL_SECONDS=1800
JOB_RETENTION_SECONDS=1800
CLEANUP_INTERVAL_SECONDS=300

# Worker polling and per-job limits.
WORKER_POLL_SECONDS=2
WORKER_CONCURRENCY=1
MAX_CONCURRENT_DOWNLOADS=2
WORKER_JOB_TIMEOUT_SECONDS=900
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=5
WORKER_HEARTBEAT_SECONDS=10
MAX_ACTIVE_JOBS=20
MAX_URL_LENGTH=2048
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_SECONDS=60
# Maximum estimated/final download size. Accepts bytes or values such as 500M.
MAX_DOWNLOAD_BYTES=500M
MAX_TEMP_DISK_BYTES=1G
MIN_FREE_DISK_BYTES=256M
# MAX_DOWNLOAD_SIZE is supported as a legacy alias when MAX_DOWNLOAD_BYTES is unset.

# Optional local override. Set this to the FFmpeg bin folder or ffmpeg executable.
# Leave empty on Render because the Docker image installs FFmpeg.
FFMPEG_PATH=
