# Local integration-test environment for VidzFlow
# Copy to .env.test or export these before running pytest

# PostgreSQL test database (used by TEST_DATABASE_URL)
TEST_DATABASE_URL=postgresql+psycopg://vidzflow:vidzflow@localhost:5433/vidzflow_test

# S3-compatible storage used by worker tests / local validation
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vidzflow-test
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Optional app-level envs for local stack startup
DATABASE_URL=postgresql+psycopg://vidzflow:vidzflow@localhost:5433/vidzflow_test
VIDZFLOW_SECRET_KEY=change-me-test-secret-32-plus-chars
MAX_ACTIVE_JOBS=20
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_SECONDS=60
